#!name = BiliBili Range 实验版 · aijc123
#!desc = 有限 Range 并发下载与本机传输选 CDN；实验功能，需真机验证。请停用其他 B 站 CDN 复写插件。
#!author = aijc123
#!homepage = https://github.com/aijc123/Bilibili-Redirect-US
#!version = 0.1.0-experimental
#!loon_version = 3.5.1
#!system = iOS,iPadOS

[Argument]
Enabled = switch,true,tag=启用实验下载
Connections = select,2,4,1,type=number,tag=每请求并发上限（1 为对照）
MaxMiB = select,4,2,8,type=number,tag=接管范围上限 MiB
AutoCDN = switch,true,tag=根据本机传输选择 CDN
PreferredCDN = select,"upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorali.bilivideo.com",tag=初始候选 CDN
Debug = switch,false,tag=诊断日志

[General]
force-http-engine-hosts = upos-sz-*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80

[Script]
http-request ^https?:\/\/(?:upos-(?:sz|hz|bstar1)-[a-z0-9-]+\.bilivideo\.com|cn-hk-eq-[a-z0-9-]+\.bilivideo\.com|upos-(?:sz|hz|bstar1)-mirrorakam\.akamaized\.net)(?::(?:80|443|4483))?\/upgcxcode\/ script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/main/dist/range.bundle.js, timeout=8, tag=Bili Range 下载, argument=[{Enabled},{Connections},{MaxMiB},{AutoCDN},{PreferredCDN},{Debug}]
generic script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/main/dist/range.bundle.js, tag=Bili Range 诊断
network-changed script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/main/dist/range.bundle.js, argument="Action=reset", tag=Bili Range 网络变化

[MITM]
hostname = upos-sz-*.bilivideo.com, upos-hz-*.bilivideo.com, upos-bstar1-*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net
