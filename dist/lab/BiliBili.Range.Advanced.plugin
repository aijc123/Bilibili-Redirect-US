#!name = BiliBili Range 对照工具 · aijc123
#!desc = 自动选择节点与有限 Range 并发；实验功能，效果待真机验证。只启用一份 B 站 CDN/Range 插件。
#!author = aijc123
#!homepage = https://github.com/aijc123/Bilibili-Redirect-US
#!version = 0.1.14-experimental
#!loon_version = 3.5.1
#!system = iOS,iPadOS

[Argument]
Enabled = switch,true,tag=启用加速
Connections = select,4,6,8,16,32,2,1,type=number,tag=并发上限（实际受块大小约束）
MinChunkKiB = select,128,64,32,type=number,tag=最小分片 KiB
GlobalJobs = select,16,24,32,8,type=number,tag=全局子请求预算
TrialMode = select,"off","4vs8","4vs16","4vs32","8vs16","8vs32",tag=并发交替对照
HTTPProtocol = select,"h1","h2",tag=HTTP 协议偏好
PlaybackRate = select,1.5,1,1.25,2,type=number,tag=诊断假设倍速（不会改变播放）
WarmDNS = switch,true,tag=切换网络后预热 DNS
MaxMiB = select,4,2,8,type=number,tag=范围上限 MiB
AutoCDN = switch,true,tag=根据本机传输选择 CDN
PreferredCDN = select,"upos-sz-mirror08c.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorali.bilivideo.com","upos-sz-mirror08h.bilivideo.com","upos-sz-mirrorbos.bilivideo.com","upos-sz-mirroralib.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorbd.bilivideo.com","upos-sz-mirror14b.bilivideo.com","upos-sz-estgoss.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com",tag=初始候选 CDN
CDNGroup = select,"baseline","mainland","overseas","all",tag=备用组（保留首选）
Debug = switch,false,tag=诊断日志

[General]
force-http-engine-hosts = upos-sz-*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80

[Script]
http-request ^https?:\/\/(?:[a-z0-9-]+\.bilivideo\.com|[a-z0-9-]+\.mcdn\.bilivideo\.cn|upos-(?:sz|hz|bstar1)-mirrorakam\.akamaized\.net)(?::(?:80|443|4480|4483|8000|8082|9102))?\/(?:upgcxcode|v1\/resource\/upgcxcode)\/ script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.14-experimental/dist/lab/range-advanced.bundle.js, timeout=8, tag=Bili Range 下载, argument=[{Enabled},{Connections},{MinChunkKiB},{GlobalJobs},{TrialMode},{HTTPProtocol},{PlaybackRate},{WarmDNS},{MaxMiB},{AutoCDN},{PreferredCDN},{CDNGroup},{Debug}]
generic script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.14-experimental/dist/lab/diagnose-advanced.bundle.js, tag=Bili Range 诊断
generic script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.14-experimental/dist/lab/dns-diagnose.bundle.js, timeout=20, tag=Bili DNS 诊断
network-changed script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.14-experimental/dist/lab/network-reset-advanced.bundle.js, timeout=20, tag=Bili Range 网络变化, argument=[{Enabled},{WarmDNS},{PreferredCDN},{CDNGroup}]

[MITM]
hostname = *.bilivideo.com, *.mcdn.bilivideo.cn, upos-*-mirrorakam.akamaized.net
