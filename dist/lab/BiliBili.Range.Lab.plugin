#!name = BiliBili Range 研发版 · aijc123
#!desc = 有限 Range 并发下载与本机传输选 CDN；实验功能，需真机验证。请停用其他 B 站 CDN 复写插件。
#!author = aijc123
#!homepage = https://github.com/aijc123/Bilibili-Redirect-US
#!version = 0.1.5-experimental
#!loon_version = 3.5.1
#!system = iOS,iPadOS

[Argument]
Enabled = switch,true,tag=启用实验下载
Connections = select,4,6,8,16,32,2,1,type=number,tag=并发上限（实际受块大小约束）
GlobalJobs = select,16,24,32,8,type=number,tag=全局子请求预算（尽力协调）
MaxMiB = select,4,2,8,type=number,tag=接管范围上限 MiB
AutoCDN = switch,true,tag=根据本机传输选择 CDN
PreferredCDN = select,"upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorali.bilivideo.com",tag=初始候选 CDN
Debug = switch,false,tag=诊断日志

[General]
force-http-engine-hosts = upos-sz-*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80

[Script]
http-request ^https?:\/\/(?:[a-z0-9-]+\.bilivideo\.com|[a-z0-9-]+\.mcdn\.bilivideo\.cn|upos-(?:sz|hz|bstar1)-mirrorakam\.akamaized\.net)(?::(?:80|443|4480|4483|8000|8082|9102))?\/(?:upgcxcode|v1\/resource\/upgcxcode)\/ script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.5-experimental/dist/lab/range.bundle.js, timeout=8, tag=Bili Range 下载, argument=[{Enabled},{Connections},{GlobalJobs},{MaxMiB},{AutoCDN},{PreferredCDN},{Debug}]
generic script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.5-experimental/dist/lab/diagnose.bundle.js, tag=Bili Range 诊断
network-changed script-path=https://raw.githubusercontent.com/aijc123/Bilibili-Redirect-US/range-v0.1.5-experimental/dist/lab/network-reset.bundle.js, tag=Bili Range 网络变化

[MITM]
hostname = *.bilivideo.com, *.mcdn.bilivideo.cn, upos-*-mirrorakam.akamaized.net
